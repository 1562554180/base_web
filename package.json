{
  "name": "qwp-antd",
  "version": "1.0.0-beta.1",
  "description": "antd integrated with qwp",
  "private": true,
  "scripts": {
    "precommit": "npm run lint-staged",
    "start": "vite",
    "build": "vite build",
    "start:webpack": "webpack serve --mode development",
    "build:webpack": "webpack --mode production",
    "dll": "webpack --config webpack.dll.config.js",
    "lint:style": "stylelint \"src/**/*.less\" --syntax less",
    "lint": "eslint --ext .js src mock tests && npm run lint:style",
    "lint:fix": "eslint --fix --ext .js src mock tests && npm run lint:style",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js",
    "test:all": "node ./tests/run-tests.js",
    "prettier": "prettier --write ./src/**/**/**/*",
    "router:php": "node ./tools/router.js --language=php",
    "router:java": "node ./tools/router.js --language=java",
    "crud": "node ./tools/crud.js",
    "code:crud": "node ./tools/crud.js",
    "code:list": "node ./tools/list.js",
    "code:php": "node ./tools/php/OpsGenerator.js",
    "save-acls:php": "php ./tools/php/save_acls.php",
    "publish": " node ./tools/publish.js --prePublish=true && npm run build && node ./tools/publish.js"
  },
